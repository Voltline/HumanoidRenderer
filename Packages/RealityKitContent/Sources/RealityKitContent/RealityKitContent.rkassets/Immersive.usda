#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["Sphere_Left", "Sphere_Right", "StereoVideoMaterial", "GridMaterial"]
    def Sphere "Sphere_Right" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/GridMaterial/GridMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0.5, 1.5, -1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Sphere "Sphere_Left" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/GridMaterial/GridMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.2
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0.08475067, 1.5276326, -1.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Material "StereoVideoMaterial"
    {
        asset inputs:LeftImage (
            customData = {
                dictionary realitykit = {
                    float2 positionInSubgraph = (-327.25, -62)
                    int stackingOrderInSubgraph = 297
                }
            }
        )
        asset inputs:RightImage (
            customData = {
                dictionary realitykit = {
                    float2 positionInSubgraph = (-338.25, 169)
                    int stackingOrderInSubgraph = 175
                }
            }
        )
        token outputs:mtlx:surface.connect = </Root/StereoVideoMaterial/UnlitSurface.outputs:out>
        token outputs:realitykit:vertex
        float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (647.47266, 102.671875)
        int ui:nodegraph:realitykit:subgraphOutputs:stackingOrder = 383

        def Shader "Combine"
        {
            uniform token info:id = "ND_realitykit_geometry_switch_cameraindex_color3"
            color3f inputs:left.connect = </Root/StereoVideoMaterial/Left.outputs:out>
            color3f inputs:mono.connect = </Root/StereoVideoMaterial/Right.outputs:out>
            color3f inputs:right.connect = </Root/StereoVideoMaterial/Right.outputs:out>
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (148.25, 118)
            int ui:nodegraph:node:stackingOrder = 378
        }

        def Shader "Left"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default
            asset inputs:file.connect = </Root/StereoVideoMaterial.inputs:LeftImage>
            string inputs:filtertype
            float2 inputs:texcoord
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (-95.75, -30)
            int ui:nodegraph:node:stackingOrder = 293
            string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["inputs:vaddressmode", "inputs:texcoord"]
        }

        def Shader "Right"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default
            asset inputs:file.connect = </Root/StereoVideoMaterial.inputs:RightImage>
            string inputs:filtertype
            float2 inputs:texcoord
            string inputs:vaddressmode
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (-100.75, 199)
            int ui:nodegraph:node:stackingOrder = 175
            string[] ui:nodegraph:realitykit:node:attributesShowingChildren = ["inputs:file"]
        }

        def Shader "UnlitSurface"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            bool inputs:applyPostProcessToneMap
            color3f inputs:color.connect = </Root/StereoVideoMaterial/Combine.outputs:out>
            bool inputs:hasPremultipliedAlpha
            float inputs:opacity
            float inputs:opacityThreshold
            token outputs:out
            float2 ui:nodegraph:node:pos = (421.53516, 117.5)
            int ui:nodegraph:node:stackingOrder = 381
        }

        def Shader "Power"
        {
            uniform token info:id = "ND_power_color3FA"
            prepend color3f inputs:in1.connect = </Root/StereoVideoMaterial/Combine.outputs:out>
            float inputs:in2 = 1.6
            color3f outputs:out
            float2 ui:nodegraph:node:pos = (249.375, 282.72266)
            int ui:nodegraph:node:stackingOrder = 393
        }
    }
}

